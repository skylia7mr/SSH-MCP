# 本地 uv 启动默认仅监听 loopback；Compose 会覆盖容器内 HOST。
SSH_MCP_HOST=127.0.0.1
SSH_MCP_PORT=8000
SSH_MCP_KNOWN_HOSTS=./known_hosts
# 不设置时默认与 known_hosts 同目录；保存连接配置和私钥，不保存密码/口令。
# SSH_MCP_CONNECTIONS_FILE=./connections.json
SSH_MCP_TRANSFER_ROOT=/tmp/ssh-mcp-files
# 服务器间中转缓存独立存放；每次传输触发检查，按批次保留最近 7 次。
SSH_MCP_TRANSFER_CACHE_ROOT=/tmp/ssh-mcp-relay
SSH_MCP_TRANSFER_CACHE_KEEP=7
SSH_MCP_MAX_TRANSFERS=4
SSH_MCP_TRANSFER_TIMEOUT_SECONDS=3600
# 留空则随机生成。固定 token 仅用于当前本地环境，勿提交 .env。
SSH_MCP_MCP_TOKEN=
SSH_MCP_MAX_SESSIONS=32
SSH_MCP_PAIRING_TTL_SECONDS=300
SSH_MCP_PAIRING_MAX_ATTEMPTS=5
SSH_MCP_MAX_GLOBAL_RUNS=16
SSH_MCP_MAX_SESSION_RUNS=4
SSH_MCP_MAX_QUEUE=64
SSH_MCP_MAX_TASK_RECORDS=1000
SSH_MCP_MAX_OUTPUT_BYTES=1048576
SSH_MCP_DEFAULT_TIMEOUT_SECONDS=60
SSH_MCP_MAX_TIMEOUT_SECONDS=3600
SSH_MCP_TASK_RETENTION_SECONDS=1800
SSH_MCP_SSH_CONNECT_TIMEOUT_SECONDS=15
SSH_MCP_SSH_KEEPALIVE_INTERVAL=30
